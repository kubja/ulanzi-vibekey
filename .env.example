# Typist Configuration Template

# STT Mode: 'remote' (API endpoint) or 'local' (runs faster-whisper locally)
WHISPER_MODE=remote

# Remote Whisper STT Endpoint (e.g. self-hosted Speaches, vLLM, OpenAI, Groq)
WHISPER_API_URL=http://localhost:8008/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_MODEL=openai/whisper-large-v3-turbo
WHISPER_PROMPT=
WHISPER_LANGUAGE=

# Local Whisper settings (active when WHISPER_MODE=local)
WHISPER_LOCAL_MODEL=base
WHISPER_LOCAL_DEVICE=auto

# Hardware target (Ulanzi AU05 default: fff1:00dd)
VENDOR_ID=fff1
PRODUCT_ID=00dd

# Dictation mode: 'hold' (push-to-talk) or 'toggle' (click to record, click to transcribe)
DICTATION_MODE=hold

# Typing speed and formatting
KEY_DELAY=0.003
APPEND_SPACE=true
